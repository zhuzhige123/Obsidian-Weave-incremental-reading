{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"allowArbitraryExtensions": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"moduleResolution": "bundler",
		"target": "ES2022",
		"verbatimModuleSyntax": false,
		"types": ["svelte", "node", "bun-types", "vitest/globals"]
	},
	"files": ["src/app.d.ts", "src/types/standalone-third-party.d.ts", "src/main.ts"],
	"exclude": ["src/demo/**", "src/tests/**", "src/test-integration.ts", "dist/**"]
}
